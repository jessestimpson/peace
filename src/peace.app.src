{application, peace, [
    {description, "Flexible Paxos: replicated state machines with configurable quorums"},
    {vsn, "0.1.0"},
    {registered, [peace_sup]},
    {mod, {peace_app, []}},
    {applications, [
        kernel,
        stdlib
    ]},
    %% The directory in which the default storage backend keeps its files.
    {env, [{data_dir, "peace_data"}]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
 ]}.
