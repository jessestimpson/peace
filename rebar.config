{erl_opts, [debug_info, warnings_as_errors]}.
{deps, []}.

{shell, [
    {apps, [peace]}
]}.

{profiles, [
    %% Deterministic simulation testing. Entered as `rebar3 as dst eunit`.
    %% Everything eta-related is scoped to this profile: the DST define that
    %% switches on include/peace_eta.hrl, the dependency, and dst/, which
    %% holds the harness and its suite.
    {dst, [
        {deps, [{eta, {git, "https://github.com/jessestimpson/eta.git", {branch, "main"}}}]},
        {erl_opts, [{d, 'DST'}]},
        {extra_src_dirs, ["dst"]},
        {eunit_tests, [{module, peace_dst_tests}]},
        {eunit_opts, [verbose]},
        {dialyzer, [{plt_extra_apps, [eunit, eta]}]}
    ]}
]}.
