{erl_opts, [debug_info, warnings_as_errors]}.
{deps, []}.

{shell, [
    {apps, [peace]}
]}.

{profiles, [
    %% Deterministic simulation testing. Run it with `rebar3 as dst eunit`.
    %% Everything related to eta is confined to this profile:
    %%   - the DST define, which enables include/peace_eta.hrl,
    %%   - the eta dependency, and
    %%   - dst/, which contains the harness and the harness's test suite.
    {dst, [
        {deps, [{eta, {git, "https://github.com/jessestimpson/eta.git", {branch, "main"}}}]},
        {erl_opts, [{d, 'DST'}]},
        {extra_src_dirs, ["dst"]},
        {eunit_tests, [{module, peace_dst_tests}]},
        {eunit_opts, [verbose]},
        {dialyzer, [{plt_extra_apps, [eunit, eta]}]}
    ]},
    %% Benchmarks. bench/ contains a key-value state machine and a benchmark
    %% harness. See bench/README.md.
    {bench, [
        {extra_src_dirs, ["bench"]},
        {eunit_tests, [{module, peace_kv_tests}]},
        {dialyzer, [{plt_extra_apps, [eunit]}]}
    ]}
]}.
